# Configurações de Ambiente
# Copie este arquivo para .env e ajuste os valores

# Chave secreta do Flask (gerar uma única e segura)
SECRET_KEY=sua-chave-secreta-mude-para-producao-use-secrets-token-hex-32

# Configurações do Portal
COMPRAS_URL=https://www.gov.br/compras/pt-br
DISPUTA_URL=https://www.gov.br/compras/pt-br/acesso-restrito/disputa

# Configurações de Sessão
SESSION_STORAGE_PATH=compras_session.json

# Configurações de Monitoramento
POLLING_INTERVAL=2.0
HEADLESS_MODE=True

# Configurações de Segurança (delays para parecer humano)
MIN_DELAY_BETWEEN_ACTIONS=0.5
MAX_DELAY_BETWEEN_ACTIONS=1.5

# Log Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
